{
  "name": "node-acid-transactions",
  "version": "1.0.0",
  "description": "Node.js simple example to work with PostgreSQL and transactions using ACID",
  "author": "Ruslan Hamzin",
  "license": "MIT",
  "scripts": {
    "dev": "tsx --env-file=.env --watch ./src/main.ts",
    "start:prod": "node --env-file=.env dist/main.js",
    "type:check": "tsc --noEmit --watch",
    "clean": "rimraf ./dist",
    "build": "pnpm clean && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.json"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.3",
    "drizzle-seed": "^0.3.1",
    "fastify": "^5.12.5",
    "pg": "^8.23.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "rimraf": "^6.1.3",
    "tsc-alias": "^1.9.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
